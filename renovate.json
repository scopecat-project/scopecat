{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "minimumReleaseAge": null
  },
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)",
    ":prHourlyLimitNone",
    "helpers:pinGitHubActionDigestsToSemver",
    "customManagers:githubActionsVersions"
  ],
  "packageRules": [
    {
      "description": "Internal versions of these public-monorepo packages are managed together by scripts/app_build/package_versions.py, not by independent registry updates",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "scopecat",
        "scopecat-server",
        "scopecat-instruments",
        "scopecat-quantum",
        "scopecat-app",
        "scopecat-tutorials",
        "scopecat-testkit"
      ],
      "enabled": false
    },
    {
      "description": "Update locked Python quality tools within their declared ranges",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "ruff",
        "basedpyright"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Review the Python uv CLI and normalized uv-build package together",
      "matchManagers": [
        "pep621",
        "custom.regex"
      ],
      "matchPackageNames": [
        "uv",
        "uv-build"
      ],
      "groupName": "Python build toolchain",
      "automerge": false
    },
    {
      "description": "Propose current-minor Python patches independently of newer minors",
      "matchManagers": [
        "pyenv"
      ],
      "separateMinorPatch": true
    },
    {
      "description": "Review exact Python patch updates with the uv runtime catalog and native packaging acceptance",
      "matchManagers": [
        "pyenv"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Python build toolchain",
      "automerge": false
    },
    {
      "description": "Keep Python minor and major upgrades separate from patch supply maintenance",
      "matchManagers": [
        "pyenv"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Override config:best-practices dev-only pinning by pinning all npm dependencies except peer dependencies",
      "matchManagers": [
        "npm"
      ],
      "extends": [
        ":pinAllExceptPeerDependencies"
      ]
    },
    {
      "description": "Keep npm dependency updates on the project-wide 3-day minimum release age",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Review Knope installer and CLI updates separately after a non-publishing release rehearsal",
      "matchPackageNames": [
        "knope-dev/action",
        "knope-dev/knope"
      ],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Automerge only approved internal UI and test-tool patch/minor updates; isolate them from inherited mixed groups",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@tanstack/react-query",
        "lucide-react",
        "@base-ui/react",
        "@types/node",
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt",
        "vitest",
        "jsdom",
        "@testing-library/jest-dom",
        "@testing-library/react"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": true
    },
    {
      "description": "Keep the React runtime and DOM renderer coordinated without enrolling React types or other React packages",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "react",
        "react-dom"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "React runtime"
    },
    {
      "description": "Keep type-aware oxlint and its declared oxlint-tsgolint peer coordinated; no other Oxc or runtime packages",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "oxlint",
        "oxlint-tsgolint"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Oxlint tooling"
    },
    {
      "description": "Automerge ruff patch/minor updates including 0.x minors only when existing checks pass without source or rule fixes",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "ruff"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": true
    }
  ],
  "pep621": {
    "ignorePaths": [
      "fixtures/installed_author_lab/pyproject.toml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The installed author fixture is built in isolation without a lockfile; update its backend without inheriting the workspace uv.lock",
      "managerFilePatterns": [
        "/^fixtures/installed_author_lab/pyproject\\.toml$/"
      ],
      "matchStrings": [
        "\\[build-system\\]\\s+requires = \\[\"(?<depName>uv_build)(?<currentValue>[^\"\\r\\n]+)\"\\]"
      ],
      "datasourceTemplate": "pypi",
      "packageNameTemplate": "uv-build",
      "versioningTemplate": "pep440"
    }
  ],
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "addLabels": [
      "security"
    ],
    "vulnerabilityFixStrategy": "lowest"
  }
}
