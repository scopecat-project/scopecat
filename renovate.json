{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "fixtures/installed_author_lab/pyproject.toml"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "minimumReleaseAge": null
  },
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)",
    ":automergePatch",
    ":automergeStableNonMajor",
    ":prHourlyLimitNone",
    "helpers:pinGitHubActionDigestsToSemver",
    "customManagers:githubActionsVersions"
  ],
  "packageRules": [
    {
      "description": "Internal versions of these public-monorepo packages are managed together by scripts/app_build/package_versions.py, not by independent registry updates",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "scopecat",
        "scopecat-server",
        "scopecat-instruments",
        "scopecat-quantum",
        "scopecat-app",
        "scopecat-tutorials",
        "scopecat-testkit"
      ],
      "enabled": false
    },
    {
      "description": "Update locked Python quality tools within their declared ranges",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "ruff",
        "basedpyright"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "\u5c06 Python uv CLI \u4e0e\u89c4\u8303\u5316\u7684 uv-build \u5305\u66f4\u65b0\u653e\u5728\u540c\u4e00\u7ec4\u5ba1\u67e5",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "uv",
        "uv-build"
      ],
      "groupName": "Python build toolchain",
      "automerge": false
    },
    {
      "description": "Propose current-minor Python patches independently of newer minors",
      "matchManagers": [
        "pyenv"
      ],
      "separateMinorPatch": true
    },
    {
      "description": "Review exact Python patch updates with the uv runtime catalog and native packaging acceptance",
      "matchManagers": [
        "pyenv"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Python build toolchain",
      "automerge": false
    },
    {
      "description": "Keep Python minor and major upgrades separate from patch supply maintenance",
      "matchManagers": [
        "pyenv"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Override config:best-practices dev-only pinning by pinning all npm dependencies except peer dependencies",
      "matchManagers": [
        "npm"
      ],
      "extends": [
        ":pinAllExceptPeerDependencies"
      ]
    },
    {
      "description": "Keep npm dependency updates on the project-wide 3-day minimum release age",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Review Knope installer and CLI updates separately after a non-publishing release rehearsal",
      "matchPackageNames": [
        "knope-dev/action",
        "knope-dev/knope"
      ],
      "groupName": null,
      "automerge": false
    }
  ]
}
