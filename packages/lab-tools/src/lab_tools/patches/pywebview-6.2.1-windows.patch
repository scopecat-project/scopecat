+    def _initialize_private_store(self):
+        core = self.webview.CoreWebView2
+        profile = core.Profile
+        key = (os.path.normcase(os.path.abspath(str(core.Environment.UserDataFolder))),
+               str(profile.ProfileName))
+        with self._private_store_lock:
+            if key not in self._private_store_tasks:
+                self._private_store_tasks[key] = None
+                try:
+                    self._private_store_tasks[key] = profile.ClearBrowsingDataAsync(
+                        CoreWebView2BrowsingDataKinds.Cookies)
+                except Exception:
+                    logger.exception('Private cookie initialization could not start')
+                    return
+            task = self._private_store_tasks[key]
+        if task is None:
+            logger.error('Private cookie initialization previously failed to start')
+            return
+        # Never block the STA message pump. Every view navigates on its own UI
+        # scheduler only after the shared cookie-only operation has completed.
+        task.ContinueWith(Action[Task](self._on_private_store_ready),
+                          self.syncContextTaskScheduler)
+
+    def _on_private_store_ready(self, task):
+        if task.IsCanceled or task.IsFaulted:
+            logger.error('Private cookie initialization failed: %s', task.Exception)
+            return
+        if self.webview.IsDisposed:
+            return
+        self._private_store_ready = True
+        self._load_initial_content()
+
